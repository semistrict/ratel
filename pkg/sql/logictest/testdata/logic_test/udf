# LogicTest: local

subtest create_and_call

# Basic JavaScript UDF with named parameters
statement ok
CREATE FUNCTION add_nums(a INT, b INT)
RETURNS INT AS $$
  return a + b;
$$ LANGUAGE plv8;

query I
SELECT add_nums(3, 4)
----
7

query I
SELECT add_nums(100, -50)
----
50

# Nested calls
query I
SELECT add_nums(add_nums(1, 2), add_nums(3, 4))
----
10

