module(name = "com_github_cockroachdb_cockroach")

# Toolchain dependencies that require bzlmod-style declaration because they
# depend on bzlmod-only internal proxy repositories (@compatibility_proxy,
# @rules_python_internal, etc.). The rest of the repo still uses WORKSPACE.

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_features", version = "1.45.0")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_java", version = "9.6.1")
bazel_dep(name = "rules_python", version = "1.6.3")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "32.1", repo_name = "com_google_protobuf")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_go", version = "0.60.0", repo_name = "io_bazel_rules_go")

# Activate rules_cc's compatibility_proxy extension (creates @cc_compatibility_proxy).
cc_compatibility_proxy = use_extension("@rules_cc//cc:extensions.bzl", "compatibility_proxy")
use_repo(cc_compatibility_proxy, "cc_compatibility_proxy")

# Activate rules_java's compatibility_proxy (creates @compatibility_proxy).
java_compat_proxy = use_extension("@rules_java//java:rules_java_deps.bzl", "compatibility_proxy")
use_repo(java_compat_proxy, "compatibility_proxy")

# rules_go 0.60 pulls gazelle as a transitive bzlmod dep, which auto-declares
# go_deps repos (gazelle~~go_deps~...) from rules_go's own go.mod. These collide
# with WORKSPACE DEPS.bzl copies of the same import paths at link time. To unify
# them, include our go.mod in gazelle's extension and use_repo the canonical
# names so everything resolves to the bzlmod copy.
bazel_dep(name = "gazelle", version = "0.50.0", repo_name = "bazel_gazelle_bzlmod")

go_deps = use_extension("@bazel_gazelle_bzlmod//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Some transitive go_deps repos (grpc-gateway upstream) load
# @rules_proto//proto:defs.bzl. rules_proto is a bazel_dep in this module but
# isn't visible by default to extension-declared repos. inject_repo makes it
# visible so those upstream loads resolve.
inject_repo(go_deps, "rules_proto")

# grpc-gateway's generated BUILD files reference @go_googleapis (the protobuf
# snapshot declared in WORKSPACE). Under bzlmod it's not visible to the
# grpc-gateway repo, so steer gazelle toward the go-only dep instead.
go_deps.gazelle_override(
    build_file_generation = "on",
    directives = [
        "gazelle:resolve go google.golang.org/genproto/googleapis/api/annotations @org_golang_google_genproto_googleapis_api//annotations",
        "gazelle:resolve go google.golang.org/genproto/googleapis/api/httpbody @org_golang_google_genproto_googleapis_api//httpbody",
    ],
    path = "github.com/grpc-ecosystem/grpc-gateway",
)

# CRDB references target :errorspb_proto on @com_github_cockroachdb_errors,
# which requires gazelle to generate proto_library rules.
go_deps.gazelle_override(
    directives = [
        "gazelle:proto default",
        "gazelle:resolve proto proto gogoproto/gogo.proto @com_github_gogo_protobuf//gogoproto:gogoproto_proto",
        "gazelle:resolve proto go gogoproto/gogo.proto @com_github_gogo_protobuf//gogoproto",
    ],
    path = "github.com/cockroachdb/errors",
)

# etcd raft's raftpb.proto imports gogoproto/gogo.proto; gazelle needs to know
# that resolves to the gogo-protobuf repo rather than an in-repo directory.
go_deps.gazelle_override(
    directives = [
        "gazelle:proto default",
        "gazelle:resolve proto proto gogoproto/gogo.proto @com_github_gogo_protobuf//gogoproto:gogoproto_proto",
        "gazelle:resolve proto go gogoproto/gogo.proto @com_github_gogo_protobuf//gogoproto",
    ],
    path = "go.etcd.io/raft/v3",
)

# CRDB references target :gogo_proto on gogo-protobuf. gazelle names the
# proto_library target <dir>_proto (gogoproto_proto), so we alias gogo_proto
# to it via a post-gazelle patch.
go_deps.gazelle_override(
    directives = [
        "gazelle:proto default",
        "gazelle:proto_strip_import_prefix /gogoproto",
    ],
    path = "github.com/gogo/protobuf",
)
