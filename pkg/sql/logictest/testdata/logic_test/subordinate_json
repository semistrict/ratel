subtest negative_index_and_residual_vectorized

statement ok
CREATE TABLE t (id INT PRIMARY KEY, j JSONB)

statement ok
INSERT INTO t VALUES
  (1, '{"a": {"b": [10, 20]}}'),
  (2, '{"a": {"b": [30]}}'),
  (3, '{"a": {"b": [40]}}'),
  (4, '{"q": "r"}')

query I
SELECT id
FROM t
WHERE j#>>'{a,b,-1}' = '20' AND id < 3
ORDER BY id
