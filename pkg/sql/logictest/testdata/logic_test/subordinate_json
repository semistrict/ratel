subtest same_path_containment_projection_vectorized

statement ok
CREATE TABLE t (id INT PRIMARY KEY, j JSONB)

statement ok
INSERT INTO t VALUES
  (1, '{"a": {"b": [10, 20]}}'),
  (2, '{"a": {"b": [30]}}'),
  (3, '{"a": {"b": [40]}}')

query IT
SELECT id, j#>>'{a,b,0}'
FROM t
WHERE j#>'{a}' @> '{"b": [30]}'
ORDER BY id
----
2 30

statement ok
DROP TABLE t

subtest null_and_empty_containment_vectorized

statement ok
CREATE TABLE t (id INT PRIMARY KEY, j JSONB)

statement ok
INSERT INTO t VALUES
  (1, '{}'),
  (2, '[]'),
  (3, 'null'),
  (4, NULL),
  (5, '{"a": null}'),
  (6, '{"a": []}'),
  (7, '{"a": {}}')

query I
SELECT id FROM t WHERE j @> '{}' ORDER BY id
----
1
5
6
7

query I
SELECT id FROM t WHERE j->'a' <@ 'null' ORDER BY id
----
5

query I
SELECT id FROM t WHERE j->'a' <@ '[]' ORDER BY id
----
6

query I
SELECT id FROM t WHERE j->'a' <@ '{}' ORDER BY id
----
7

statement ok
DROP TABLE t
