subtest null_handling

# NULL input passes through as JS null
statement ok
CREATE FUNCTION null_check(x INT) RETURNS INT AS $$
  return x === null ? -1 : x * 2;
$$ LANGUAGE plv8;

query I
SELECT null_check(5)
----
10

query I
SELECT null_check(NULL)
----
-1

# NULL output: JS null becomes SQL NULL
statement ok
CREATE FUNCTION maybe_null(x INT) RETURNS INT AS $$
  if (x < 0) return null;
  return x;
$$ LANGUAGE plv8;

query I
SELECT maybe_null(42)
----
42

query I
SELECT maybe_null(-1)
----
NULL

# NULL with strings
statement ok
CREATE FUNCTION greet_or_null(name TEXT) RETURNS TEXT AS $$
  if (name === null) return null;
  return "Hello, " + name + "!";
$$ LANGUAGE plv8;

query T
SELECT greet_or_null('Alice')
----
Hello, Alice!

query T
SELECT greet_or_null(NULL)
----
NULL

# NULL in table scan context
statement ok
CREATE TABLE nullable_data (id INT PRIMARY KEY, val INT);
INSERT INTO nullable_data VALUES (1, 10), (2, NULL), (3, 30), (4, NULL), (5, 50);

query II rowsort
SELECT id, null_check(val) FROM nullable_data
----
1  20
2  -1
3  60
4  -1
5  100

query II rowsort
SELECT id, maybe_null(COALESCE(val, -1)) FROM nullable_data
----
1  10
2  NULL
3  30
4  NULL
5  50

statement ok
DROP FUNCTION null_check(x INT);
DROP FUNCTION maybe_null(x INT);
DROP FUNCTION greet_or_null(name TEXT);
DROP TABLE nullable_data;

