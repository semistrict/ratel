subtest virtual_column_vectorized

statement ok
CREATE TABLE t (
  id INT PRIMARY KEY,
  j JSONB,
  jt STRING AS (j#>>'{a,b,-1}') VIRTUAL
)

statement ok
INSERT INTO t (id, j) VALUES
  (1, '{"a": {"b": [10, 20]}}'),
  (2, '{"a": {"b": [30]}}'),
  (3, '{"q": "r"}')

query IT
SELECT id, coalesce(jt, 'NULL')
FROM t
WHERE jt IS NOT NULL
ORDER BY id
----
1 20
2 30

statement ok
DROP TABLE t

