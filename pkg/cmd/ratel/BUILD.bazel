load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "ratel_lib",
    srcs = ["main.go"],
    importpath = "github.com/cockroachdb/cockroach/pkg/cmd/ratel",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/cli",
    ],
)

go_binary(
    name = "ratel",
    embed = [":ratel_lib"],
    visibility = ["//visibility:public"],
)
