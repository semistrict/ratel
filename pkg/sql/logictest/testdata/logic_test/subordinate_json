subtest access_and_exists_vectorized

statement ok
SET distsql = always

statement ok
SET vectorize = on

statement ok
CREATE TABLE t (id INT PRIMARY KEY, j JSONB)

statement ok
INSERT INTO t VALUES
  (1, '{"a": {"b": [10, 20]}, "z": 7}'),
  (2, '{"a": {"b": [30]}, "z": 8}'),
  (3, '{"q": "r"}'),
  (4, NULL),
  (5, 'null')

query TTT
SELECT
  (j ? 'a')::STRING,
  coalesce(j->>'z', 'NULL'),
